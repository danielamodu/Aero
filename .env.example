# Copy to .env.local and fill in (never commit .env.local)
# Required to send waitlist confirmation emails — https://resend.com/api-keys
RESEND_API_KEY=
# Sender identity. Until useaero.org is verified in Resend, keep the
# onboarding address and test with your own email (Resend trial restriction).
WAITLIST_FROM=Aero <onboarding@resend.dev>
# Optional: receive an email for every signup
WAITLIST_NOTIFY=
