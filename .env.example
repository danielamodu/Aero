# Copy to .env.local and fill in (never commit .env.local)
# Required to send waitlist confirmation emails — https://resend.com/api-keys
RESEND_API_KEY=
# Sender identity (useaero.org is verified — use the domain address)
WAITLIST_FROM=Aero <hello@useaero.org>
# Optional: receive an email for every signup
WAITLIST_NOTIFY=
# Signs confirmation links + admin cookie. Set a long random string in prod.
WAITLIST_SECRET=
# Neon Postgres (project "aero"). Get it from console.neon.tech → Connect.
# Enables durable signups, positions, referrals, and real /admin data.
DATABASE_URL=
# Identity is Fuji-only, requires the shared Neon/Postgres database, and has no local-file fallback.
AERO_AUTH_ORIGIN=
AERO_FUJI_RPC_URL=
# Use at least 32 random bytes. The same secret hashes session tokens and rate-limit keys.
AERO_SESSION_SECRET=
# Configurable proposed defaults; seconds. Absolute expiry may not exceed 30 days.
AERO_SESSION_IDLE_SECONDS=43200
AERO_SESSION_ABSOLUTE_SECONDS=604800
# Retention purge is intentionally disabled until product/privacy owners approve a policy.
AERO_IDENTITY_RETENTION_POLICY_APPROVED=false
AERO_IDENTITY_RETENTION_DAYS=
# Gates /admin. Pick something strong.
ADMIN_PASSWORD=
# Analytics: create the site at plausible.io (add domain useaero.org) — no key needed, script is already wired.
# Release classification is required for builds. Production/beta stay blocked until reviewed gates pass.
AERO_RELEASE_ENVIRONMENT=
NEXT_PUBLIC_AERO_RELEASE_ENVIRONMENT=
AERO_RELEASE_CHAIN_ID=
NEXT_PUBLIC_AERO_RELEASE_CHAIN_ID=
# Required for the testnet release classification (Avalanche Fuji).
# AERO_RELEASE_CHAIN_ID=43113
# --- Testnet (testnet.useaero.org) ---
# Reown Cloud project ID (free at cloud.reown.com) — enables wallet connect
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Fuji contract addresses (from `forge script script/Deploy.s.sol --rpc-url fuji --broadcast`)
NEXT_PUBLIC_TEST_USDC=
NEXT_PUBLIC_AERO_VAULT=
NEXT_PUBLIC_AERO_NAMES=
# Router, one-tx pay, sandbox bank (from DeployMore.s.sol)
NEXT_PUBLIC_ROUTER=
NEXT_PUBLIC_AEROPAY=
NEXT_PUBLIC_BANK=
# Deployer key for Fuji (test key only — never mainnet, never commit)
DEPLOYER_KEY=
